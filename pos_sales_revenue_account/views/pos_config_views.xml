<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherit_sales_revenue_account" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.sales.revenue.account</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="Accounting"
                         help="Sales Revenue Account overrides the standard product/category income account for sales generated from this Point of Sale. Leave empty to use standard Odoo behavior.">
                    <field name="sales_revenue_account_id" placeholder="Use product/category income account"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
